// @title Weight of the air
// @by Eign0x

const BPM = 174;
const END = 160;
const LEVEL = 1.25;
const START_CYCLE = 0;
const LOOP = false;
setcps(BPM / 240);

//Samples
await samples({
  rd_jkick: 'jazz/000_BD.wav',
  rd_jsnare: 'jazz/007_SN.wav',
  rd_jhat: 'jazz/003_HH.wav',
  rd_jopen: 'jazz/004_OH.wav'
}, 'https://raw.githubusercontent.com/tidalcycles/Dirt-Samples/master/');

//Pattern
const kick = p => s(p).lpf(2400).gain(0.82).orbit(1);
const snare = p => s(p).hpf(160).lpf(9500).gain(0.62).room(0.07).roomsize(1.1).orbit(1);
const hats = p => s(p).hpf(4400).gain("0.20 0.11 0.17 0.10")
  .pan("0.46 0.54").swingBy(0.12, 4).orbit(1);
const ka = kick("<[rd_jkick ~ ~ ~ ~ ~ rd_jkick ~ ~ ~ rd_jkick ~ ~ ~ ~ ~] [rd_jkick ~ ~ ~ ~ ~ ~ ~ ~ ~ rd_jkick ~ ~ ~ rd_jkick ~]>");
const kb = kick("<[rd_jkick ~ ~ ~ ~ ~ ~ rd_jkick ~ ~ rd_jkick ~ ~ ~ ~ ~] [rd_jkick ~ ~ ~ ~ ~ rd_jkick ~ ~ ~ ~ ~ ~ ~ rd_jkick ~]>");
const kc = kick("<[rd_jkick ~ ~ ~ ~ rd_jkick ~ ~] [~ rd_jkick ~ ~ ~ ~ rd_jkick ~]>");
const backbeat = snare("~ rd_jsnare ~ rd_jsnare");
const ghostA = snare("<[~ ~ ~ ~ ~ ~ ~ ~] [~ ~ ~ rd_jsnare ~ ~ ~ ~]>").gain(0.10);
const ghostB = snare("<[~ ~ ~ ~ ~ rd_jsnare ~ ~] [~ ~ ~ ~ ~ ~ ~ rd_jsnare]>").gain(0.12);
const open = s("<[~ ~ ~ ~ ~ ~ ~ rd_jopen] [~ ~ ~ ~ ~ ~ ~ ~]>")
  .end(0.25).clip(0.9).hpf(4800).gain(0.12).pan(0.58).orbit(1);
const a = stack(ka, backbeat, hats("rd_jhat*8"), ghostA);
const b = stack(kb, backbeat, hats("rd_jhat ~ rd_jhat rd_jhat rd_jhat ~ rd_jhat ~"), ghostB, open);
const c = stack(kc, backbeat, hats("~ rd_jhat ~ rd_jhat rd_jhat ~ rd_jhat ~"), ghostA);
const turn = stack(
  kick("rd_jkick ~ ~ ~ ~ ~ rd_jkick ~"),
  snare("~ rd_jsnare ~ [rd_jsnare rd_jsnare]").gain("0.56 0.60 0.26"),
  hats("rd_jhat*4")
);
const grooveA = arrange([4, a], [2, b], [2, a]);
const grooveB = arrange([2, b], [2, c], [3, a], [1, turn]);
const grooveC = arrange([4, c], [2, b], [1, a], [1, turn]);
const soft = stack(kick("rd_jkick ~ ~ ~").gain(0.43), hats("~ rd_jhat ~ rd_jhat").gain(0.10));

const roots = "<d1 bb1 f1 c2>".slow(4);
const lowA = roots.struct("x@2 ~ x ~ ~ x ~");
const lowB = roots.struct("~ x@2 ~ x ~ x ~");
const sub = p => note(p).s('sine').lpf(115).pan(0.5)
  .attack(0.02).decay(0.10).sustain(0.83).release(0.10).clip(0.86).gain(1.1).orbit(2);
const body = p => note(p).s('triangle').hpf(110).lpf(640)
  .attack(0.03).decay(0.18).sustain(0.62).release(0.11).clip(0.83).gain(0.30).orbit(2);
const bassA = stack(sub(lowA), body(lowA));
const bassB = stack(sub(lowB), body(lowB).lpf(900));
const harmony = "<[d3,f3,a3,e4] [bb2,d3,f3,a3] [f3,a3,c4,g4] [c3,e3,g3,d4]>".slow(4);
const piano = p => note(p).s('sine').fm(0.85).fmh(2)
  .fmdecay(0.22).fmsustain(0.09).hpf(220).lpf(2300)
  .attack(0.012).decay(0.55).sustain(0.20).release(0.65).clip(0.85)
  .gain(0.21).room(0.23).roomsize(3).roomlp(2400).orbit(3);
const keys = piano(harmony.struct("x@3 ~ x@2 ~ ~"));
const keysOpen = piano(harmony.struct("x@5 ~ x ~")).gain(0.23);
const pad = note(harmony).s('triangle').hpf(300).lpf(1050)
  .attack(0.9).release(1.2).clip(0.90).gain(0.09)
  .room(0.30).roomsize(3.5).roomlp(1800).orbit(3);
const line = note("<[a3@2 ~ c4 ~ e4 ~ ~] [f3@2 ~ a3 ~ d4 ~ ~] [c4@2 ~ a3 ~ g3 ~ ~] [g3@2 ~ e3 ~ d3 ~ ~]>").slow(4)
  .s('sine').fm(0.18).fmh(2).hpf(250).lpf(1700)
  .attack(0.09).decay(0.22).sustain(0.42).release(0.42).clip(0.82).gain(0.22)
  .delay(0.10).delaytime(60 / BPM * 1.5).delayfeedback(0.20)
  .room(0.24).roomsize(3.0).roomlp(2000).orbit(3);
const lift = s('pink').slow(8).hpf(2400).lpf(5500)
  .attack(8 * 240 / BPM - 0.2).decay(0).sustain(1).release(0.2).clip(0.98).gain(0.03).orbit(4);

//Stacks
const song = arrange(
  [16, stack(keys, pad, arrange([8, silence], [8, soft]))],
  [24, stack(arrange([8, grooveA], [8, grooveB], [8, grooveA]), bassA, keys)],
  [16, stack(grooveB, bassA, line)],
  [16, stack(grooveC, bassB, keysOpen)],
  [16, stack(soft, sub(roots.struct("x@3 ~")).gain(0.75), keysOpen, pad, line)],
  [8, stack(grooveC.hpf(750).gain(0.25), keys, lift)],
  [24, stack(arrange([8, grooveB], [8, grooveA], [8, grooveC]), bassB, keysOpen, line)],
  [16, stack(grooveB, bassA, keys)],
  [16, stack(arrange([8, grooveA], [8, c]), sub(lowA).gain(0.80), pad, line)],
  [8, stack(keys, pad, soft.gain(0.12))]
);
const fade = signal(t => {
  const pos = LOOP ? Number(t) % END : Number(t);
  return LEVEL * Math.max(0, Math.min(1, (END - pos) / 8));
});
song.postgain(fade).filterWhen(t => Number(t) >= 0 && (LOOP || Number(t) < END)).early(START_CYCLE)
